# Copy to .env on the server. NEVER put this file in the Android APK or Git.
PORT=8787
NODE_ENV=production
PUBLIC_BASE_URL=https://YOUR_API_DOMAIN
DATABASE_FILE=./data/ggez.sqlite
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OWNER_ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_OWNER_SECRET
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Merchant payout instructions shown to customers. Fill only the methods you accept.
PAYMENT_UPI_ID=yourname@upi
PAYMENT_UPI_NAME=Your Merchant Name
PAYMENT_BANK_NAME=YOUR_BANK_NAME
PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_HOLDER_NAME
PAYMENT_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
PAYMENT_IFSC=YOUR_IFSC_CODE
PAYMENT_BANK_BRANCH=YOUR_BRANCH
PAYMENT_INSTRUCTIONS=Pay using UPI or bank transfer, then submit the transaction reference. Access is granted only after manual verification.

# Plans (prices are strings to avoid floating-point currency errors)
PLUGIN_STUDIO_MONTHLY_PRICE=YOUR_MONTHLY_PRICE
PLUGIN_STUDIO_YEARLY_PRICE=YOUR_YEARLY_PRICE
PLUGIN_STUDIO_LIFETIME_PRICE=YOUR_LIFETIME_PRICE
CURRENCY=INR
